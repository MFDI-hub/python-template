site_name: "{{ package_name }}"
site_description: "{{ package_description }}"

repo_url: https://github.com/{{ package_github_org }}/{{ package_name }}
repo_name: {{ package_github_org }}/{{ package_name }}
edit_uri: edit/main/docs/

theme:
  name: material

plugins:
  - search
  - git-revision-date-localized:
      enable_creation_date: true

markdown_extensions:
  - pymdownx.snippets:
      base_path: ["."]

nav:
  - Home: index.md
  - Installation: installation.md
  - Development: development.md
  - Publishing: publishing.md
