site_name: "{{ package_name }}"
site_description: "{{ package_description }}"
# Canonical URL for the sitemap. docs.yml publishes a GitHub Pages project site.
# For Read the Docs, use https://{{ package_name }}.readthedocs.io/ instead.
site_url: https://{{ package_github_org }}.github.io/{{ package_name }}/

repo_url: https://github.com/{{ package_github_org }}/{{ package_name }}
repo_name: {{ package_github_org }}/{{ package_name }}
edit_uri: edit/main/docs/

theme:
  name: material
  features:
    - content.code.copy
    - navigation.sections
    - search.suggest

plugins:
  - search
  - git-revision-date-localized:
      enable_creation_date: true
      fallback_to_build_date: true
  # Pulls docstrings straight out of the package. Use it in a page with:
  #   ::: {{ package_module }}
  - mkdocstrings:
      default_handler: python
      handlers:
        python:
          # RTD never installs the project. This lets mkdocstrings import it from src/.
          paths: [src]
          options:
            show_source: false
            show_root_heading: true
            docstring_style: google
            separate_signature: true
            merge_init_into_class: true

markdown_extensions:
  - pymdownx.snippets:
      base_path: ["."]
  - pymdownx.highlight:
      anchor_linenums: true
  - pymdownx.inlinehilite
  - pymdownx.superfences
  - admonition
  - toc:
      permalink: true

nav:
  - Home: index.md
  - Installation: installation.md
  - API Reference: api.md
  - Development: development.md
  - Publishing: publishing.md
